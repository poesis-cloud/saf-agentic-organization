# Framework layout of this plugin (rendered by builds/plugin): the harness resolves every
# directory against the plugin root; the workspace comes from the session's marker.
FRAMEWORK_AGENTS_DIR=framework/agents
FRAMEWORK_ARTIFACTS_DIR=framework/artifacts
FRAMEWORK_INSTRUCTIONS_DIR=framework/instructions
FRAMEWORK_SKILLS_DIR=framework/skills
FRAMEWORK_TEMPLATES_DIR=framework/templates
FRAMEWORK_WORKFLOWS_DIR=framework/workflows
FRAMEWORK_WORKSPACE_DIR=workspace
