{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://saf/artifacts/portfolio-vision.artifact/v1",
  "$ref": "gsmarc://saf/contracts/artifact/v1",
  "title": "portfolio-vision artifact schema",
  "type": "object",
  "additionalProperties": true,
  "x-artifact": {
    "id": "portfolio-vision",
    "kind": "portfolio-vision",
    "template": "templates/layers/portfolio/actors/value-management-officer/artifacts/portfolio-vision.artifact-template.md",
    "pathPatterns": [
      "portfolio-vision.md"
    ],
    "renderOnly": false
  },
  "required": [
    "__path",
    "__kind",
    "__artifact_id",
    "__frontmatter_present"
  ],
  "properties": {
    "__path": {
      "description": "Workspace-relative path",
      "type": "string",
      "minLength": 1
    },
    "__kind": {
      "description": "Artifact-kind discriminator",
      "const": "portfolio-vision"
    },
    "__artifact_id": {
      "description": "Stable artifact id",
      "type": "string",
      "minLength": 1
    },
    "__frontmatter_present": {
      "description": "Harness assertion",
      "type": "boolean"
    },
    "__sections": {
      "type": "object",
      "additionalProperties": true
    },
    "__body": {
      "description": "Raw Markdown body",
      "type": "string"
    },
    "title": {
      "description": "Human-readable title",
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "description": "Derivation provenance (narrowed subtype of the base contract's sources): refs to the upstream artifact(s) this portfolio-vision was built from. Allowed source kinds: strategic-themes.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "(^|/)([a-z0-9-]+\\.)?(strategic-themes)\\.md$"
      }
    },
    "stepOutcomes": {
      "description": "Step outcome record \u2014 one entry per step that committed this artifact (see the stepOutcomes definition).",
      "$ref": "#/$defs/stepOutcomes"
    }
  },
  "$defs": {
    "stepOutcomes": {
      "description": "Step outcome record. Every workflow step that commits this artifact appends exactly one entry, so the artifact itself carries the step's decision \u2014 including `confirmed`, `no-change` and `none` \u2014 and the agent's reply stays indicative.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "step",
          "outcome",
          "date",
          "note"
        ],
        "properties": {
          "step": {
            "description": "`<workflow-slug>/<step-slug>` of the step that appended this entry.",
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
          },
          "outcome": {
            "description": "written (created) | revised (content changed) | confirmed (reviewed, still valid) | no-change (out of scope on this run) | none (not needed; the artifact records that decision)",
            "enum": [
              "written",
              "revised",
              "confirmed",
              "no-change",
              "none"
            ]
          },
          "date": {
            "description": "YYYY-MM-DD of the step.",
            "type": "string",
            "minLength": 1
          },
          "note": {
            "description": "One line: what the step decided and why.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
