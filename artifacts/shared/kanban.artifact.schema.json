{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://saf/artifacts/kanban.artifact/v1",
  "$ref": "gsmarc://saf/contracts/artifact/v1",
  "title": "Kanban board artifact schema",
  "description": "The rendered board of one backlog: which item is in which state. Rendered from the items' `status`; the items stay the source of truth.",
  "type": "object",
  "additionalProperties": true,
  "x-artifact": {
    "kind": "kanban",
    "layer": "shared",
    "class": "record",
    "owners": [],
    "templates": [
      "templates/kanbans/art-kanban.artifact-template.md",
      "templates/kanbans/portfolio-kanban.artifact-template.md",
      "templates/kanbans/solution-train-kanban.artifact-template.md",
      "templates/kanbans/team-kanban.artifact-template.md"
    ],
    "pathPatterns": [
      "portfolio/portfolio-kanban.md",
      "portfolio/solution-trains/*/solution-train-kanban.md",
      "portfolio/arts/*/art-kanban.md",
      "portfolio/arts/*/teams/*/team-kanban.md"
    ],
    "sections": {
      "required": [
        "Board"
      ],
      "optional": [
        "Flow notes"
      ]
    }
  },
  "required": [
    "title",
    "level",
    "scope",
    "updated",
    "columns",
    "stepOutcomes"
  ],
  "properties": {
    "title": {
      "description": "Human-readable title.",
      "type": "string",
      "minLength": 1
    },
    "level": {
      "description": "The backlog rendered. One of: portfolio | solution-train | art | team.",
      "enum": [
        "portfolio",
        "solution-train",
        "art",
        "team"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "The folder whose backlog is rendered. Workspace-relative path."
    },
    "updated": {
      "type": "string",
      "minLength": 1,
      "description": "YYYY-MM-DD of the last rendering."
    },
    "columns": {
      "type": "array",
      "description": "One entry per state, in flow order.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "state",
          "items"
        ],
        "properties": {
          "state": {
            "type": "string",
            "minLength": 1,
            "description": "State name."
          },
          "wipLimit": {
            "type": [
              "number",
              "null"
            ],
            "description": "Work-in-process limit, or null."
          },
          "items": {
            "type": "array",
            "description": "Paths of the items in this state.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "stepOutcomes": {
      "description": "Step outcome record: one entry per step that committed this artifact.",
      "$ref": "#/$defs/stepOutcomes"
    }
  },
  "$defs": {
    "stepOutcomes": {
      "description": "Step outcome record. Every workflow step that commits this artifact appends exactly one entry, so the artifact itself carries the step's decision and the agent's reply stays indicative.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "step",
          "outcome",
          "date",
          "note"
        ],
        "properties": {
          "step": {
            "description": "`<workflow-slug>/<step-slug>` of the step that appended this entry.",
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
          },
          "outcome": {
            "description": "written (created) | revised (content changed) | confirmed (reviewed, still valid) | no-change (out of scope on this run) | none (not needed; the artifact records that decision).",
            "enum": [
              "written",
              "revised",
              "confirmed",
              "no-change",
              "none"
            ]
          },
          "date": {
            "description": "YYYY-MM-DD of the step.",
            "type": "string",
            "minLength": 1
          },
          "note": {
            "description": "One line: what the step decided and why.",
            "type": "string",
            "minLength": 1
          },
          "friction": {
            "description": "Optional. Workflow friction the actor observed (raw input for Inspect and Adapt, never a fix).",
            "type": "string"
          }
        }
      }
    }
  }
}
